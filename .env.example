# =======================================================
# MedBot Configuration Environment Variables (Clinical)
# Copy this file to .env and configure your credentials
# =======================================================

# Model Provider: "google" (recommended for fast multimodal clinical analysis) or "groq"
MODEL_PROVIDER=google

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq API Key (Get key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Server Configuration
HOST=127.0.0.1
PORT=8000
REQUEST_TIMEOUT=90

